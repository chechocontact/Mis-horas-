rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada persona solo puede leer y escribir sus propios datos.
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Turnos recientes y pendientes: un documento por turno.
      match /turnos/{turnoId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      // Historial: turnos pagados de más de 1 mes, un documento por mes.
      match /archivo/{mes} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
    // Todo lo demás está cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
