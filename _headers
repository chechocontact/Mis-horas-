# Cabeceras para Cloudflare Pages (equivalen a las de netlify.toml).
# El service worker, la página y la configuración siempre se revisan contra el servidor,
# para que cada cambio que publiques llegue a todos los teléfonos.
/*
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/firebase-config.js
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
